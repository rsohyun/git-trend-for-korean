# 필수값이지만 CLI 실행에는 쓰이지 않습니다. HTTP API(uvicorn)로 띄울 때만 인증 토큰으로 사용합니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_WORKER_TOKEN=

# LLM (OpenAI 호환). LLM_PROVIDER=fake 이면 가짜 응답
LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# none | json_object (서버가 response_format을 지원할 때만 json_object)
LLM_JSON_MODE=none

# GitHub (선택, 없으면 README 조회 시간당 60회 제한)
GITHUB_TOKEN=

# Langfuse (선택, LLM 호출 기록)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 공개 사이트 주소 (메일 링크용, 예: https://xxx.vercel.app). 비우면 GitHub로 연결
SITE_URL=
